{
  "name": "cf-bbs",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Workers + D1 + R2 + KV + Turnstile BBS (Free Plan optimized)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB_MAIN --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB_MAIN --remote",
    "db:migrate:shard1:local": "wrangler d1 migrations apply DB_SHARD_1 --local",
    "db:migrate:shard1:remote": "wrangler d1 migrations apply DB_SHARD_1 --remote",
    "db:migrate:shard2:local": "wrangler d1 migrations apply DB_SHARD_2 --local",
    "db:migrate:shard2:remote": "wrangler d1 migrations apply DB_SHARD_2 --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  }
}
